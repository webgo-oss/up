<% const _nav = typeof nav !== 'undefined' ? nav : ''; %>
<header class="topbar">
  <div class="topbar-left">
    <a class="brand" href="/">Crewdesk</a>
    <nav class="mainnav" aria-label="Main">
      <% if (user.role === 'admin') { %>
        <a href="/admin" class="<%= _nav === 'tasks' ? 'current' : '' %>">Tasks<% if (typeof reviewCount !== 'undefined' && reviewCount > 0) { %> <span class="badge"><%= reviewCount %> to review</span><% } %></a>
        <a href="/admin/calendar" class="<%= _nav === 'calendar' ? 'current' : '' %>">Calendar</a>
        <a href="/admin/tasks/new" class="<%= _nav === 'new' ? 'current' : '' %>">New task</a>
        <a href="/admin/people" class="<%= _nav === 'people' ? 'current' : '' %>">People</a>
      <% } else { %>
        <a href="/employee" class="<%= _nav === 'available' ? 'current' : '' %>">Available</a>
        <a href="/employee/mine" class="<%= _nav === 'mine' ? 'current' : '' %>">My tasks<% if (typeof redoCount !== 'undefined' && redoCount > 0) { %> <span class="badge"><%= redoCount %> to fix</span><% } %></a>
        <a href="/employee/calendar" class="<%= _nav === 'calendar' ? 'current' : '' %>">Calendar</a>
      <% } %>
    </nav>
  </div>
  <div class="topbar-right">
    <span class="who">
      <span class="avatar"><%= user.name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase() %></span>
      <span class="who-text"><strong><%= user.name %></strong><small class="role-tag"><%= user.role %></small></span>
    </span>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-ghost" type="submit">Sign out</button>
    </form>
  </div>
</header>
